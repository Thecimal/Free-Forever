REPO_PATH=/path/to/quantified-self-mcp
LLM_BASE_URL=http://localhost:PORT/v1
LLM_API_KEY=replace-me
LLM_MODEL=replace-with-supported-model
# Optional: several OmniRoute models (comma-separated), each its own source.
# LLM_MODELS=model-a,model-b
# Optional: how several sources are combined: fallback (default), parallel or aggregate.
# LLM_STRATEGY=fallback
# Optional: add a local model (Ollama API) as one more source.
# LOCAL_BASE_URL=http://localhost:11434
# LOCAL_MODEL=replace-with-local-model
GITHUB_REPOSITORY=Thecimal/quantified-self-mcp
MAX_CONTEXT_CHARS=50000
